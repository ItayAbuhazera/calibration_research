    "        )\n",
    "        data_map[key] = {'img': img, 'label': lbl, 'grid': grid, 'vector': vec}\n",
    "\n",
    "    # --- 5. Compute Distances ---\n",
    "    anchor_vec = data_map['Anchor']['vector']\n",
    "    friend_dist = np.linalg.norm(anchor_vec - data_map['Friend']['vector'])\n",
    "    foe_dist = np.linalg.norm(anchor_vec - data_map['Foe']['vector'])\n",
    "\n",
    "    # --- 6. Plotting ---\n",
    "    fig = plt.figure(figsize=(16, 10))\n",
    "    gs = gridspec.GridSpec(3, 3, height_ratios=[1, 1, 1.2])\n",
    "    \n",
    "    cols = ['Anchor', 'Friend', 'Foe']\n",
    "    dist_labels = [\n",
    "        f\"Class {data_map['Anchor']['label']}\\n(Reference)\", \n",
    "        f\"Class {data_map['Friend']['label']}\\nDist: {friend_dist:.4f} (Close)\", \n",
    "        f\"Class {data_map['Foe']['label']}\\nDist: {foe_dist:.4f} (Far)\"\n",
    "    ]\n",
    "    \n",
    "    for i, col_name in enumerate(cols):\n",
    "        data = data_map[col_name]\n",
    "        \n",
    "        # Row 1: Original Image\n",
    "        ax_img = plt.subplot(gs[0, i])\n",
    "        ax_img.imshow(data['img'])\n",
    "        ax_img.set_title(dist_labels[i], fontsize=14, fontweight='bold')\n",
    "        ax_img.axis('off')\n",
    "        \n",
    "        # Row 2: 16x16 Grid\n",
    "        ax_grid = plt.subplot(gs[1, i])\n",
    "        im = ax_grid.imshow(data['grid'], cmap='inferno', interpolation='nearest')\n",
    "        ax_grid.set_title(f\"16x16 Coordinate Grid\", fontsize=10)\n",
    "        ax_grid.axis('off')\n",
    "        \n",
    "        # Row 3: 21D Vector\n",
    "        ax_vec = plt.subplot(gs[2, i])\n",
    "        colors = ['#440154'] * 16 + ['#21918c'] * 4 + ['#fde725'] * 1\n",
