    "    \n",
    "    # Legend\n",
    "    from matplotlib.patches import Patch\n",
    "    legend_elements = [\n",
    "        Patch(facecolor='#440154', label='4x4 (16 dims)'),\n",
    "        Patch(facecolor='#21918c', label='2x2 (4 dims)'),\n",
