    "ax1.set_title('Reliability Diagram')
",
    "ax1.legend(loc='upper left')
",
    "ax1.set_xlim(0, 1)
",
    "ax1.set_ylim(0, 1)
",
    "ax1.set_xticklabels([])
",
    "
",
    "# Bottom: Histogram of samples per bin
",
    "ax2.bar(bin_centers, bin_counts, width=bin_width * 0.8, 
