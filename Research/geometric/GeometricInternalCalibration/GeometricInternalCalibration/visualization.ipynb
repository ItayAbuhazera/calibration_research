   "source": [
    "import numpy as np
",
    "import matplotlib.pyplot as plt
",
    "import os
",
    "from pathlib import Path
",
    "import re
",
    "
",
    "def calculate_ece_adaptive(max_probs, correct, n_bins=15):
",
    "    \"\"\"
",
    "    Calculate Expected Calibration Error using adaptive binning (equal samples per bin).
",
    "    \"\"\"
",
    "    # Sort by confidence
",
    "    sorted_indices = np.argsort(max_probs)
",
    "    sorted_probs = max_probs[sorted_indices]
",
    "    sorted_correct = correct[sorted_indices]
",
    "    
",
    "    # Split into equal-mass bins
",
    "    bin_size = len(max_probs) // n_bins
",
    "    total_samples = len(max_probs)
",
    "    
",
    "    ece = 0.0
",
    "    
",
    "    for i in range(n_bins):
",
    "        start_idx = i * bin_size
",
    "        end_idx = (i + 1) * bin_size if i < n_bins - 1 else len(max_probs)
",
    "        
",
    "        bin_probs = sorted_probs[start_idx:end_idx]
",
    "        bin_correct = sorted_correct[start_idx:end_idx]
",
    "        
",
    "        bin_accuracy = bin_correct.mean()
",
    "        bin_confidence = bin_probs.mean()
",
    "        bin_count = len(bin_probs)
",
    "        
",
    "        # ECE contribution: |accuracy - confidence| * (bin_count / total_samples)
",
    "        ece += abs(bin_accuracy - bin_confidence) * (bin_count / total_samples)
",
    "    
",
    "    return ece
",
    "
",
    "def calculate_adaptive_ece(max_probs, correct, n_bins=15):
",
    "    \"\"\"
",
    "    Calculate Adaptive Expected Calibration Error (ECE with equal-frequency binning).
",
    "    Uses the same approach as in compare_dac_geometric.py
",
    "    \"\"\"
",
    "    # Adaptive binning: equal number of samples per bin
",
    "    n_samples = len(max_probs)
",
    "    sorted_indices = np.argsort(max_probs)
",
    "    sorted_confidences = max_probs[sorted_indices]
",
    "    
",
    "    # Create bin boundaries with equal number of samples per bin
",
    "    bin_boundaries = np.interp(
",
    "        np.linspace(0, n_samples, n_bins + 1),
",
    "        np.arange(n_samples),
",
    "        sorted_confidences
",
    "    )
",
    "    
",
    "    ece = 0.0
",
    "    for i in range(n_bins):
",
    "        bin_lower = bin_boundaries[i]
",
    "        bin_upper = bin_boundaries[i + 1]
",
    "        
",
    "        # Include samples in this bin
",
    "        if i == n_bins - 1:
",
    "            # Last bin includes upper boundary
",
    "            in_bin = (max_probs >= bin_lower) & (max_probs <= bin_upper)
",
    "        else:
",
    "            in_bin = (max_probs >= bin_lower) & (max_probs < bin_upper)
",
    "        
",
    "        prop_in_bin = np.mean(in_bin)
",
    "        
",
    "        if prop_in_bin > 0:
",
    "            accuracy_in_bin = np.mean(correct[in_bin])
",
    "            avg_confidence_in_bin = np.mean(max_probs[in_bin])
",
    "            ece += np.abs(avg_confidence_in_bin - accuracy_in_bin) * prop_in_bin
",
    "    
",
    "    return ece
",
    "
",
    "def plot_reliability_diagram_adaptive(max_probs, correct, title=\"Reliability Diagram\", 
",
    "                                       save_path=None, n_bins=15):
",
    "    \"\"\"
",
    "    Reliability diagram with adaptive binning (equal samples per bin).
",
    "    This ensures all bins are populated for fair visual comparison.
",
    "    \"\"\"
",
    "    # Calculate both ECE and Adaptive ECE
",
    "    ece = calculate_ece_adaptive(max_probs, correct, n_bins=n_bins)
",
    "    adaptive_ece = calculate_adaptive_ece(max_probs, correct, n_bins=15)
",
    "    
",
    "    # Sort by confidence
",
    "    sorted_indices = np.argsort(max_probs)
",
    "    sorted_probs = max_probs[sorted_indices]
",
    "    sorted_correct = correct[sorted_indices]
",
    "    
",
    "    # Split into equal-mass bins
",
    "    bin_size = len(max_probs) // n_bins
",
    "    
",
    "    accuracies = []
",
    "    avg_confidences = []
",
    "    bin_edges = [0]
",
    "    
",
    "    for i in range(n_bins):
",
    "        start_idx = i * bin_size
",
    "        end_idx = (i + 1) * bin_size if i < n_bins - 1 else len(max_probs)
",
    "        
",
    "        bin_probs = sorted_probs[start_idx:end_idx]
",
    "        bin_correct = sorted_correct[start_idx:end_idx]
",
    "        
",
    "        accuracies.append(bin_correct.mean())
",
    "        avg_confidences.append(bin_probs.mean())
",
    "        bin_edges.append(bin_probs.max())
",
    "    
",
    "    bin_edges[-1] = 1.0
",
    "    
",
    "    # Plot
",
    "    fig, ax = plt.subplots(figsize=(8, 6))
",
    "    
",
    "    # Use avg_confidences as x-positions for variable-width bars
",
    "    bar_widths = np.diff([0] + avg_confidences + [1])[:-1]  # Approximate widths
",
    "    
",
    "    # Simple version: bars at average confidence positions
",
    "    ax.bar(avg_confidences, accuracies, width=0.08, 
",
    "           label='Accuracy', alpha=0.7, edgecolor='black')
",
    "    
",
    "    # Perfect calibration line
",
    "    ax.plot([0, 1], [0, 1], 'k--', label='Perfect calibration')
",
    "    
",
    "    # Show bin boundaries as light vertical lines
",
    "    for edge in bin_edges[1:-1]:
",
    "        ax.axvline(x=edge, color='gray', linestyle=':', alpha=0.3)
",
    "    
",
    "    ax.set_xlabel('Confidence (adaptive bins)')
",
    "    ax.set_ylabel('Accuracy')
",
    "    
",
    "    # Add both ECE and Adaptive ECE to title
",
    "    title_with_ece = f\"{title}\nECE = {ece:.4f}, Adaptive ECE = {adaptive_ece:.4f}\"
",
    "    ax.set_title(title_with_ece)
",
    "    ax.legend()
",
    "    ax.set_xlim(0, 1)
",
    "    ax.set_ylim(0, 1)
",
    "    
",
    "    plt.tight_layout()
",
    "    
",
    "    if save_path:
",
    "        plt.savefig(save_path, dpi=150, bbox_inches='tight')
",
    "        print(f\"Saved: {save_path}\")
",
    "    
",
    "    plt.show()
",
    "    plt.close()
",
    "
",
    "def extract_metadata_from_filename(filepath):
",
    "    \"\"\"
",
    "    Extract metadata from filename like:
",
    "    resnet50_cifar100_baseline_cross_entropy_seed15_coordinate_per_sample.npz
",
    "    \"\"\"
",
    "    filename = Path(filepath).stem
",
    "    path_parts = Path(filepath).parts
",
    "    
",
    "    metadata = {
",
    "        'model': None,
",
    "        'dataset': None,
",
    "        'training_method': None,
",
    "        'seed': None,
",
    "        'method': None,
",
    "        'full_path': filepath
",
    "    }
",
    "    
",
    "    # Extract seed
",
    "    seed_match = re.search(r'seed(\d+)', filename)
",
    "    if seed_match:
",
    "        metadata['seed'] = int(seed_match.group(1))
",
    "    
",
    "    # Extract method (check in order of specificity)
",
    "    if 'coordinate' in filename:
",
    "        metadata['method'] = 'coordinate'
",
    "    elif 'dac' in filename and 'coordinate' not in filename:
",
    "        metadata['method'] = 'dac'
",
    "    elif 'geometric' in filename:
",
    "        metadata['method'] = 'geometric'
",
    "    elif 'sgc_lite' in filename:
",
    "        metadata['method'] = 'sgc_lite'
",
    "    elif 'sgc' in filename:
",
    "        metadata['method'] = 'sgc'
",
    "    elif 'temperature_scaling' in filename or 'temperature' in filename:
",
    "        metadata['method'] = 'temperature'
",
    "    elif 'uncalibrated' in filename:
",
    "        metadata['method'] = 'uncalibrated'
",
    "    
",
    "    # Extract model and dataset from path or filename
",
    "    for part in path_parts + (filename,):
",
    "        if 'resnet' in part.lower():
",
    "            if 'resnet18' in part.lower():
",
    "                metadata['model'] = 'resnet18'
",
    "            elif 'resnet50' in part.lower():
",
    "                metadata['model'] = 'resnet50'
",
    "            elif 'resnet101' in part.lower():
",
    "                metadata['model'] = 'resnet101'
",
    "            elif 'resnet152' in part.lower():
",
    "                metadata['model'] = 'resnet152'
",
    "        elif 'densenet' in part.lower():
",
    "            if 'densenet121' in part.lower():
",
    "                metadata['model'] = 'densenet121'
",
    "        if 'cifar100' in part.lower():
",
    "            metadata['dataset'] = 'cifar100'
",
    "        elif 'cifar10' in part.lower():
",
    "            metadata['dataset'] = 'cifar10'
",
    "        elif 'tiny_imagenet' in part.lower():
",
    "            metadata['dataset'] = 'tiny_imagenet'
",
    "        if 'baseline_cross_entropy' in part:
",
    "            metadata['training_method'] = 'baseline_cross_entropy'
",
    "    
",
    "    return metadata"
   ]
