    "\n",
    "    # --- 4. Extract Features for All Three ---\n",
    "    data_map = {}\n",
    "    indices = {'Anchor': anchor_index, 'Friend': friend_index, 'Foe': foe_index}\n",
    "    \n",
    "    for key, idx in indices.items():\n",
    "        # Pass model_name so helper knows to resize\n",
