    "    ]\n",
    "    ax4.legend(handles=legend_elements, loc='lower right', fontsize=8)\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n",
