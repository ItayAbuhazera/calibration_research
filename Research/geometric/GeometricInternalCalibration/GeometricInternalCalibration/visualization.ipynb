    "    ax0.axis('off')\n",
    "    \n",
    "    # 2. 16x16 Pseudo-Image\n",
    "    ax1 = plt.subplot(gs[:, 1])\n",
    "    # Normalize grid for better visualization color contrast\n",
    "    im1 = ax1.imshow(grid_16x16, cmap='inferno', interpolation='nearest')\n",
    "    ax1.set_title(r\"Step 1: Reshape to $16 \\times 16$\" + \"\\n(256 Random Activations)\", fontsize=12)\n",
    "    ax1.axis('off')\n",
    "    plt.colorbar(im1, ax=ax1, fraction=0.046, pad=0.04)\n",
    "    \n",
    "    # Arrow\n",
    "    ax_arrow = plt.subplot(gs[:, 2])\n",
    "    ax_arrow.text(0.5, 0.5, \"SPP\\nMax Pool\", ha='center', va='center', fontsize=12, fontweight='bold')\n",
    "    ax_arrow.axis('off')\n",
    "    \n",
    "    # 3. SPP Pyramids (Stacked)\n",
    "    # 4x4\n",
    "    ax2 = plt.subplot(gs[0, 3])\n",
    "    im2 = ax2.imshow(grid_4x4, cmap='inferno', interpolation='nearest', vmin=grid_16x16.min(), vmax=grid_16x16.max())\n",
    "    ax2.set_title(r\"Level 1: $4 \\times 4$ Grid\", fontsize=10)\n",
    "    for i in range(4):\n",
    "        for j in range(4):\n",
    "            # Show value if it fits, simplified format\n",
    "            val = grid_4x4[i, j]\n",
    "            color = 'black' if val > grid_4x4.max()/2 else 'white'\n",
    "            ax2.text(j, i, f\"{val:.1f}\", ha=\"center\", va=\"center\", color=color, fontsize=6)\n",
    "    ax2.axis('off')\n",
    "    \n",
    "    # 2x2 and 1x1 below\n",
    "    sub_gs = gridspec.GridSpecFromSubplotSpec(1, 2, subplot_spec=gs[1, 3])\n",
    "    \n",
    "    ax3a = plt.subplot(sub_gs[0])\n",
    "    ax3a.imshow(grid_2x2, cmap='inferno', interpolation='nearest', vmin=grid_16x16.min(), vmax=grid_16x16.max())\n",
    "    ax3a.set_title(r\"L2: $2 \\times 2$\", fontsize=10)\n",
    "    ax3a.axis('off')\n",
    "    \n",
    "    ax3b = plt.subplot(sub_gs[1])\n",
    "    ax3b.imshow(grid_1x1, cmap='inferno', interpolation='nearest', vmin=grid_16x16.min(), vmax=grid_16x16.max())\n",
    "    ax3b.set_title(r\"L3: $1 \\times 1$\", fontsize=10)\n",
    "    ax3b.text(0, 0, f\"{grid_1x1[0,0]:.1f}\", ha=\"center\", va=\"center\", color=\"white\" if grid_1x1[0,0] < grid_16x16.max()/2 else \"black\", fontsize=8)\n",
    "    ax3b.axis('off')\n",
    "    \n",
    "    # 4. Final Vector (21D)\n",
    "    ax4 = plt.subplot(gs[:, 4])\n",
    "    colors = ['#440154'] * 16 + ['#21918c'] * 4 + ['#fde725'] * 1 \n",
    "    \n",
    "    # Plot bars\n",
    "    y_pos = range(len(final_vector))\n",
    "    ax4.barh(y_pos, final_vector[::-1], color=colors[::-1]) # Reverse for top-down visual\n",
    "    \n",
    "    ax4.set_title(\"Step 3: Final Feature Vector\\n(21 Dimensions)\", fontsize=12)\n",
    "    ax4.set_xlabel(\"Activation Magnitude\")\n",
