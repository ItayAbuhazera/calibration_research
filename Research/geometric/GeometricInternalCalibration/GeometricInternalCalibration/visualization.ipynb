",
    "        ('top_label_isotonic', 'top_label_isotonic'),
",
    "    ]
",
    "    
",
    "    if not metadata['method']:
",
    "        for pattern, method in method_patterns:
",
    "            if pattern in filename:
",
    "                metadata['method'] = method
",
    "                break
",
    "    
",
    "    # Extract model/dataset from path
",
