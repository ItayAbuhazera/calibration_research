",
    "max_probs = data['max_probs']
",
    "correct = data['correct']
",
    "
",
    "n_bins = 10
",
    "bin_edges = np.linspace(0, 1, n_bins + 1)
",
    "
",
    "# Calculate stats per bin
",
    "accuracies = []
",
    "avg_confidences = []
",
    "bin_counts = []
",
    "
",
    "for i in range(n_bins):
",
    "    if i == n_bins - 1:
",
    "        mask = (max_probs >= bin_edges[i]) & (max_probs <= bin_edges[i + 1])
",
    "    else:
",
    "        mask = (max_probs >= bin_edges[i]) & (max_probs < bin_edges[i + 1])
",
    "    
",
    "    bin_counts.append(mask.sum())
",
    "    if mask.sum() > 0:
",
    "        accuracies.append(correct[mask].mean())
",
    "        avg_confidences.append(max_probs[mask].mean())
",
    "    else:
",
    "        accuracies.append(np.nan)
",
    "        avg_confidences.append(np.nan)
",
    "
",
    "# Create figure with two subplots
",
    "fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(8, 8), 
