    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import matplotlib.gridspec as gridspec\n",
    "\n",
    "def visualize_spp_pipeline(features_256, save_path=\"spp_visualization.png\"):\n",
    "    \"\"\"\n",
    "    Visualizes the SGC Coordinate -> Grid -> SPP pipeline.\n",
    "    \n",
    "    Args:\n",
    "        features_256: A numpy array of shape (256,) containing the raw coordinates.\n",
    "    \"\"\"\n",
    "    # 1. Reshape to 16x16 Grid\n",
    "    grid_16x16 = features_256.reshape(16, 16)\n",
    "    \n",
    "    # 2. Compute SPP Levels (Max Pooling)\n",
    "    # Level 1: 4x4 grid (pool size 4x4)\n",
    "    grid_4x4 = grid_16x16.reshape(4, 4, 4, 4).max(axis=(1, 3))\n",
    "    \n",
    "    # Level 2: 2x2 grid (pool size 8x8)\n",
    "    grid_2x2 = grid_16x16.reshape(2, 8, 2, 8).max(axis=(1, 3))\n",
    "    \n",
    "    # Level 3: 1x1 grid (Global Max)\n",
    "    grid_1x1 = np.array([[grid_16x16.max()]])\n",
    "    \n",
    "    # 3. Create the Plot\n",
    "    fig = plt.figure(figsize=(15, 6))\n",
    "    gs = gridspec.GridSpec(2, 4, width_ratios=[1, 0.2, 1, 1])\n",
    "    \n",
    "    # --- Plot A: The \"Pseudo-Image\" (16x16) ---\n",
    "    ax1 = plt.subplot(gs[:, 0])\n",
    "    im1 = ax1.imshow(grid_16x16, cmap='viridis', interpolation='nearest')\n",
    "    ax1.set_title(r\"Step 1: Reshape to $16 \\times 16$\" + \"\\n(256 Random Coordinates)\", fontsize=12)\n",
    "    ax1.axis('off')\n",
    "    plt.colorbar(im1, ax=ax1, fraction=0.046, pad=0.04)\n",
    "\n",
    "    # Arrow\n",
    "    ax_arrow = plt.subplot(gs[:, 1])\n",
    "    ax_arrow.text(0.5, 0.5, \"SPP\\nMax Pool\", ha='center', va='center', fontsize=12, fontweight='bold')\n",
    "    ax_arrow.axis('off')\n",
    "\n",
    "    # --- Plot B: The SPP Pyramids ---\n",
    "    # We stack them vertically in the 3rd column\n",
    "    \n",
    "    # 4x4\n",
    "    ax2 = plt.subplot(gs[0, 2])\n",
    "    im2 = ax2.imshow(grid_4x4, cmap='viridis', interpolation='nearest', vmin=grid_16x16.min(), vmax=grid_16x16.max())\n",
    "    ax2.set_title(r\"Level 1: $4 \\times 4$ Grid\", fontsize=10)\n",
    "    # Add values text for clarity (optional)\n",
    "    for i in range(4):\n",
    "        for j in range(4):\n",
    "            ax2.text(j, i, f\"{grid_4x4[i, j]:.1f}\", ha=\"center\", va=\"center\", color=\"white\", fontsize=6)\n",
    "    ax2.axis('off')\n",
    "\n",
    "    # 2x2\n",
    "    ax3 = plt.subplot(gs[1, 2])\n",
    "    # Position the 2x2 and 1x1 side-by-side in the bottom slot\n",
    "    sub_gs = gridspec.GridSpecFromSubplotSpec(1, 2, subplot_spec=gs[1, 2])\n",
    "    \n",
    "    ax3a = plt.subplot(sub_gs[0])\n",
    "    ax3a.imshow(grid_2x2, cmap='viridis', interpolation='nearest', vmin=grid_16x16.min(), vmax=grid_16x16.max())\n",
    "    ax3a.set_title(r\"Level 2: $2 \\times 2$\", fontsize=10)\n",
    "    ax3a.axis('off')\n",
    "    \n",
    "    ax3b = plt.subplot(sub_gs[1])\n",
    "    ax3b.imshow(grid_1x1, cmap='viridis', interpolation='nearest', vmin=grid_16x16.min(), vmax=grid_16x16.max())\n",
    "    ax3b.set_title(r\"L3: $1 \\times 1$\", fontsize=10)\n",
    "    ax3b.axis('off')\n",
    "\n",
    "    # --- Plot C: The Final Vector ---\n",
    "    ax4 = plt.subplot(gs[:, 3])\n",
    "    \n",
    "    # Flatten and concatenate\n",
    "    final_vector = np.concatenate([grid_4x4.flatten(), grid_2x2.flatten(), grid_1x1.flatten()])\n",
    "    colors = ['#440154'] * 16 + ['#21918c'] * 4 + ['#fde725'] * 1 # Color code by level\n",
    "    \n",
    "    bars = ax4.barh(range(len(final_vector)), final_vector[::-1], color=colors[::-1]) # Reverse to match top-down order\n",
    "    ax4.set_title(\"Step 3: Final Feature Vector\\n(21 Dimensions)\", fontsize=12)\n",
    "    ax4.set_xlabel(\"Activation Magnitude\")\n",
    "    ax4.set_yticks([])\n",
    "    \n",
    "    # Add legend manually\n",
    "    from matplotlib.patches import Patch\n",
    "    legend_elements = [Patch(facecolor='#440154', label='Level 1 (4x4)'),\n",
    "                       Patch(facecolor='#21918c', label='Level 2 (2x2)'),\n",
    "                       Patch(facecolor='#fde725', label='Level 3 (1x1)')]\n",
    "    ax4.legend(handles=legend_elements, loc='lower right')\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(save_path, dpi=300, bbox_inches='tight')\n",
    "    plt.show()\n",
    "\n",
    "# --- Example Usage ---\n",
    "# Simulate 256 random coordinates (e.g., from ReLU activations, so mostly positive)\n",
    "# Some high activations (feature detected), some zero (dead neurons)\n",
    "np.random.seed(42)\n",
    "simulated_features = np.maximum(0, np.random.randn(256) * 2) \n",
    "\n",
    "visualize_spp_pipeline(simulated_features)"
   ]
