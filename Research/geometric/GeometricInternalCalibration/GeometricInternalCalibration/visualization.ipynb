",
    "        else:
",
    "            for i, (center, acc, alpha) in enumerate(zip(
",
    "                bin_centers[valid_mask], 
",
    "                mean_accuracies[valid_mask], 
",
    "                alphas
",
    "            )):
",
    "                ax.bar(center, acc, width=bin_width*0.8, alpha=alpha, 
",
    "                      color=color, edgecolor='black', linewidth=0.5)
",
    "        
",
    "        # Perfect calibration line
",
    "        ax.plot([0, 1], [0, 1], 'k--', linewidth=1, zorder=10)
",
    "        
",
    "        display_name = method_display_names.get(method_name, method_name.upper())
",
    "        ece_str = f\"{bin_stats['ece_mean']:.3f}\"
",
    "        if bin_stats['n_seeds'] > 1:
",
    "            ece_str += f\" ± {bin_stats['ece_std']:.3f}\"
",
    "        ax.set_title(f\"{display_name}\nECE = {ece_str}\", fontsize=9)
",
    "        
",
    "        if idx == 0:
",
    "            ax.set_ylabel('Accuracy', fontsize=9)
",
    "        if not show_histogram:
",
    "            ax.set_xlabel('Confidence', fontsize=9)
",
    "        ax.set_xlim(0, 1)
