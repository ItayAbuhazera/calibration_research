",
    "        if bin_stats['n_seeds'] > 1:
",
    "            errors = bin_stats['ci_accuracies']
",
    "        else:
",
    "            errors = None
",
    "        
",
    "        valid_mask = ~np.isnan(mean_accuracies)
",
    "        
",
    "        # Normalize counts for alpha (0.3 to 0.9 range)
",
    "        valid_counts = mean_counts[valid_mask]
",
    "        if len(valid_counts) > 0 and valid_counts.max() > 0:
",
    "            max_count = valid_counts.max()
",
    "            alphas = 0.3 + 0.6 * (valid_counts / max_count)
",
    "        else:
",
    "            alphas = np.ones(len(valid_counts)) * 0.7
",
    "        
",
    "        # Plot bars with variable alpha
",
    "        if errors is not None:
",
    "            valid_errors = errors[valid_mask]
