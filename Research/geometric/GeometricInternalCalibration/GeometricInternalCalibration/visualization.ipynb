    "    plan_coordinate_extraction,\n",
    "    extract_coordinate_features\n",
    ")\n",
    "\n",
    "def visualize_real_example(\n",
    "    model_name, \n",
    "    dataset_name, \n",
    "    model_path, \n",
    "    device, \n",
    "    image_index=0, \n",
    "    seed=42, \n",
    "    save_path=\"real_spp_viz.png\"\n",
    "):\n",
    "    \"\"\"\n",
    "    Visualizes the Coordinate SPP pipeline on a REAL image from the test set.\n",
    "    \"\"\"\n",
    "    device = torch.device(device)\n",
    "    \n",
    "    # 1. Load Data & Model\n",
    "    print(f\"Loading {dataset_name} data...\")\n",
    "    _, _, test_loader, num_classes = get_data_loaders(\n",
    "        dataset_name, batch_size=1, seed=seed\n",
    "    )\n",
    "    \n",
    "    print(f\"Loading model from {model_path}...\")\n",
    "    model = load_trained_model(\n",
    "        model_path, model_name, num_classes, device, dataset=dataset_name\n",
    "    )\n",
    "    model.eval()\n",
    "\n",
    "    # 2. Get specific image\n",
    "    # We iterate to the specific index\n",
    "    dataset = test_loader.dataset\n",
    "    image_tensor, label = dataset[image_index]\n",
    "    image_tensor = image_tensor.unsqueeze(0).to(device) # Add batch dim\n",
    "    \n",
    "    # Denormalize image for visualization (CIFAR-10 stats)\n",
    "    # Assuming standard CIFAR normalization was used\n",
    "    mean = np.array([0.4914, 0.4822, 0.4465])\n",
    "    std = np.array([0.2023, 0.1994, 0.2010])\n",
    "    \n",
    "    img_viz = image_tensor.squeeze().cpu().numpy().transpose(1, 2, 0)\n",
    "    img_viz = std * img_viz + mean\n",
    "    img_viz = np.clip(img_viz, 0, 1)\n",
    "\n",
    "    # 3. Coordinate Extraction Setup (Mini-version of your pipeline)\n",
    "    print(\"Discovering coordinate space...\")\n",
    "    # Determine input shape based on dataset\n",
    "    if 'cifar' in dataset_name.lower():\n",
    "        input_shape = (1, 3, 32, 32)\n",
    "    elif 'tiny' in dataset_name.lower():\n",
    "        input_shape = (1, 3, 64, 64)\n",
    "    \n",
    "    layer_map, total_size = discover_coordinate_space(\n",
    "        model, input_shape=input_shape, device=str(device)\n",
    "    )\n",
    "    \n",
    "    print(f\"Planning extraction for 256 coordinates (Seed {seed})...\")\n",
    "    sampling_plan, global_order = plan_coordinate_extraction(\n",
    "        total_size=total_size,\n",
    "        num_coordinates=256,\n",
    "        layer_map=layer_map,\n",
    "        seed=seed\n",
    "    )\n",
    "    \n",
    "    # 4. Extract the 256 raw features\n",
    "    print(\"Extracting features...\")\n",
    "    # We create a mini loader just for this one image to use your utility\n",
    "    single_loader = DataLoader([dataset[image_index]], batch_size=1)\n",
    "    \n",
    "    features_256 = extract_coordinate_features(\n",
    "        model, single_loader, sampling_plan, layer_map, global_order, device=str(device)\n",
    "    )\n",
    "    \n",
    "    features_np = features_256.squeeze().numpy()\n",
    "    \n",
    "    # 5. SPP Logic (Manual computation for viz)\n",
    "    grid_16x16 = features_np.reshape(16, 16)\n",
    "    \n",
    "    # 4x4 Pooling (Level 1)\n",
    "    # Reshape to (4, 4, 4, 4) -> (RowBlocks, ColBlocks, RowInside, ColInside)\n",
    "    grid_4x4 = grid_16x16.reshape(4, 4, 4, 4).max(axis=(1, 3))\n",
    "    \n",
    "    # 2x2 Pooling (Level 2)\n",
    "    # Reshape to (2, 8, 2, 8)\n",
    "    grid_2x2 = grid_16x16.reshape(2, 8, 2, 8).max(axis=(1, 3))\n",
    "    \n",
    "    # 1x1 Pooling (Level 3)\n",
    "    grid_1x1 = np.array([[grid_16x16.max()]])\n",
    "    \n",
    "    # Final Vector (21D)\n",
    "    final_vector = np.concatenate([grid_4x4.flatten(), grid_2x2.flatten(), grid_1x1.flatten()])\n",
    "\n",
    "    # --- PLOTTING ---\n",
    "    fig = plt.figure(figsize=(18, 6))\n",
    "    # Layout: Original | 16x16 Grid | SPP Levels | Final Vector\n",
