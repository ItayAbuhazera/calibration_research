    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import torch\n",
    "import matplotlib.gridspec as gridspec\n",
    "from torch.utils.data import DataLoader\n",
    "from torchvision import transforms\n",
    "\n",
    "# --- Import your project modules ---\n",
    "from Experiments.run_post_hoc_calibration import (\n",
    "    load_trained_model, \n",
    "    get_data_loaders, \n",
    "    PyTorchModelAdapter\n",
    ")\n",
    "from utils.coordinate_extraction import (\n",
    "    discover_coordinate_space,\n",
    "    plan_coordinate_extraction,\n",
    "    extract_coordinate_features\n",
    ")\n",
    "\n",
    "def get_image_and_features(model, dataset, index, sampling_plan, layer_map, global_order, device):\n",
    "    \"\"\"\n",
    "    Helper to extract image, label, grid, and final vector for a single index.\n",
    "    \"\"\"\n",
    "    # 1. Get Image and Label\n",
    "    image_tensor, label = dataset[index]\n",
    "    \n",
    "    # 2. Denormalize for visualization\n",
    "    mean = np.array([0.4914, 0.4822, 0.4465])\n",
    "    std = np.array([0.2023, 0.1994, 0.2010])\n",
    "    img_viz = image_tensor.cpu().numpy().transpose(1, 2, 0)\n",
    "    img_viz = std * img_viz + mean\n",
    "    img_viz = np.clip(img_viz, 0, 1)\n",
    "    \n",
    "    # 3. Extract Features (256 Coords)\n",
    "    # Create a dummy loader for just this image\n",
    "    single_loader = DataLoader([dataset[index]], batch_size=1)\n",
    "    \n",
    "    # Extract\n",
    "    features_256 = extract_coordinate_features(\n",
    "        model, single_loader, sampling_plan, layer_map, global_order, device=str(device)\n",
    "    )\n",
    "    features_np = features_256.squeeze().numpy()\n",
    "    \n",
    "    # 4. SPP Logic to get Final Vector (21D)\n",
    "    grid_16x16 = features_np.reshape(16, 16)\n",
    "    grid_4x4 = grid_16x16.reshape(4, 4, 4, 4).max(axis=(1, 3))\n",
    "    grid_2x2 = grid_16x16.reshape(2, 8, 2, 8).max(axis=(1, 3))\n",
    "    grid_1x1 = np.array([[grid_16x16.max()]])\n",
    "    \n",
    "    final_vector = np.concatenate([grid_4x4.flatten(), grid_2x2.flatten(), grid_1x1.flatten()])\n",
    "    \n",
    "    # L2 Normalize the final vector (Crucial for SGC comparison!)\n",
    "    final_vector_norm = final_vector / (np.linalg.norm(final_vector) + 1e-12)\n",
    "    \n",
    "    return img_viz, label, grid_16x16, final_vector_norm\n",
    "\n",
    "def visualize_comparison(\n",
    "    model_name, \n",
    "    dataset_name, \n",
    "    model_path, \n",
    "    device, \n",
    "    anchor_index=42, \n",
    "    seed=11, \n",
    "    save_path=\"sgc_class_comparison.png\"\n",
    "):\n",
    "    device = torch.device(device)\n",
    "    \n",
    "    # --- 1. Load Data & Model ---\n",
    "    print(f\"Loading {dataset_name} data...\")\n",
    "    _, _, test_loader, num_classes = get_data_loaders(\n",
    "        dataset_name, batch_size=1, seed=seed\n",
    "    )\n",
    "    dataset = test_loader.dataset\n",
    "    \n",
    "    print(f\"Loading model from {model_path}...\")\n",
    "    model = load_trained_model(\n",
    "        model_path, model_name, num_classes, device, dataset=dataset_name\n",
    "    )\n",
    "    model.eval()\n",
    "\n",
    "    # --- 2. Setup Coordinate Extraction ---\n",
    "    print(\"Discovering coordinate space...\")\n",
    "        # dinov2 is expecting 224x224 coordinates\n",
    "    if 'dinov2' in model_name.lower():\n",
    "        input_shape = (1, 3, 224, 224)\n",
    "        layer_map, total_size = discover_coordinate_space(model, input_shape=input_shape, device=str(device))\n",
    "    else:\n",
    "        input_shape = (1, 3, 32, 32) if 'cifar' in dataset_name.lower() else (1, 3, 64, 64)\n",
    "        layer_map, total_size = discover_coordinate_space(model, input_shape=input_shape, device=str(device))\n",
    "\n",
    "    print(f\"Planning extraction (Seed {seed})...\")\n",
    "    sampling_plan, global_order = plan_coordinate_extraction(\n",
    "        total_size, 256, layer_map, seed=seed\n",
    "    )\n",
    "\n",
    "    # --- 3. Find Friend (Same Class) and Foe (Diff Class) ---\n",
    "    anchor_img, anchor_label = dataset[anchor_index]\n",
    "    print(f\"Anchor Index: {anchor_index}, Class: {anchor_label}\")\n",
    "    \n",
    "    friend_index = None\n",
    "    foe_index = None\n",
    "    \n",
    "    # Simple search\n",
    "    for i in range(len(dataset)):\n",
    "        if i == anchor_index: continue\n",
    "        _, lbl = dataset[i]\n",
    "        \n",
    "        if friend_index is None and lbl == anchor_label:\n",
    "            friend_index = i\n",
    "        if foe_index is None and lbl != anchor_label:\n",
    "            foe_index = i\n",
    "            \n",
    "        if friend_index is not None and foe_index is not None:\n",
    "            break\n",
    "            \n",
    "    print(f\"Found Friend Index: {friend_index}\")\n",
    "    print(f\"Found Foe Index: {foe_index}\")\n",
    "\n",
    "    # --- 4. Extract Features for All Three ---\n",
    "    data_map = {}\n",
    "    indices = {'Anchor': anchor_index, 'Friend': friend_index, 'Foe': foe_index}\n",
    "    \n",
