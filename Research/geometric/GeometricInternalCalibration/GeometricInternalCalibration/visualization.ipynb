",
    "            # Option 4: Weighted alpha without histogram
",
    "            save_path = output_dir / f\"{model}_{dataset}_comparison_weighted_alpha\"
",
    "            plot_method_comparison_weighted_alpha(methods_stats, model, dataset, str(save_path), show_histogram=False)
",
    "            
",
    "            # Option 4b: Weighted alpha with histogram
",
    "            save_path = output_dir / f\"{model}_{dataset}_comparison_weighted_alpha_with_hist\"
",
    "            plot_method_comparison_weighted_alpha(methods_stats, model, dataset, str(save_path), show_histogram=True)
",
    "    
",
    "    # Option 3: Generate plots with adaptive binning
",
    "    print(\"\nCreating comparison plots with adaptive binning (Option 3)...\")
",
    "    all_methods_by_config_adaptive = defaultdict(dict)
",
    "    
",
    "    for group_key, data_list in grouped_data.items():
",
    "        model, dataset, training_method, method = group_key
",
    "        config_key = (model, dataset, training_method)
",
    "        
",
    "        # Compute bin statistics with adaptive binning
",
    "        bin_stats_adaptive = compute_bin_statistics(data_list, n_bins=15, bin_type='adaptive')
",
    "        all_methods_by_config_adaptive[config_key][method] = bin_stats_adaptive
",
    "    
",
    "    for config_key, methods_stats in all_methods_by_config_adaptive.items():
",
    "        model, dataset, training_method = config_key
",
    "        
",
    "        if len(methods_stats) > 1:
",
    "            # Adaptive binning - bars without histogram
