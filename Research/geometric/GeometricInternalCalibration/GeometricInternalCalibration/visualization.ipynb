",
    "def main():
",
    "    \"\"\"Main function to generate all aggregated reliability diagrams.\"\"\"
",
    "    base_dir = \"reliability_data\"
",
    "    output_dir = Path(\"reliability_diagrams_main\")
",
    "    output_dir.mkdir(exist_ok=True)
",
    "    
",
    "    # Load and group data
",
    "    print(\"Loading and grouping data...\")
",
    "    grouped_data = load_and_group_data(base_dir)
",
    "    
",
    "    print(f\"Found {len(grouped_data)} unique (model, dataset, training_method, method) combinations\")
",
    "    
",
    "    # Process each group
",
    "    all_methods_by_config = defaultdict(dict)
",
    "    
",
    "    for group_key, data_list in grouped_data.items():
",
    "        model, dataset, training_method, method = group_key
",
    "        
",
    "        print(f\"\nProcessing: {model} - {dataset} - {method} ({len(data_list)} seeds)\")
",
    "        
",
    "        # Compute bin statistics with equal-width binning
",
    "        bin_stats = compute_bin_statistics(data_list, n_bins=15, bin_type='equal_width')
",
    "        
",
    "        # Create title with method display name
",
    "        method_display_names = {
",
    "            'uncalibrated': 'Uncalibrated',
",
    "            'temperature_scaling': 'Temperature Scaling',
",
    "            'sgc': 'RGC-L',
",
    "            'sgc_lite': 'RGC-C',
",
    "            'dac': 'DAC',
",
    "            'geometric': 'Geometric',
",
    "            'coordinate': 'Coordinate',
",
    "            'sgc_trust_score': 'RGC-L (Trust Score)',
",
    "            'top_label_isotonic': 'Iso'
",
    "        }
",
    "        method_display = method_display_names.get(method, method.upper())
",
    "        title = f\"{model.upper()} {dataset.upper()} - {method_display}\"
",
    "        
",
    "        # Save individual method plot
",
    "        save_path = output_dir / f\"{model}_{dataset}_{method}_aggregated\"
",
    "        plot_single_method_aggregated(bin_stats, title, str(save_path))
",
    "        
",
    "        # Store for comparison plots (group by model and dataset, ignore training_method for comparison)
",
    "        config_key = (model, dataset, training_method)
",
    "        all_methods_by_config[config_key][method] = bin_stats
",
    "    
",
    "    # Create comparison plots with all variants
",
    "    print(\"\nCreating comparison plots with all visualization options...\")
",
    "    for config_key, methods_stats in all_methods_by_config.items():
",
    "        model, dataset, training_method = config_key
",
    "        
",
    "        if len(methods_stats) > 1:
",
    "            # Option 1: Original bars without histogram
",
    "            save_path = output_dir / f\"{model}_{dataset}_comparison\"
",
    "            plot_method_comparison(methods_stats, model, dataset, str(save_path), show_histogram=False)
",
    "            
",
    "            # Option 1b: Bars with histogram
",
    "            save_path = output_dir / f\"{model}_{dataset}_comparison_with_hist\"
",
    "            plot_method_comparison(methods_stats, model, dataset, str(save_path), show_histogram=True)
",
    "            
",
    "            # Option 2: Curves without histogram
",
    "            save_path = output_dir / f\"{model}_{dataset}_comparison_curves\"
",
    "            plot_method_comparison_curves(methods_stats, model, dataset, str(save_path), show_histogram=False)
",
    "            
",
    "            # Option 2b: Curves with histogram
",
    "            save_path = output_dir / f\"{model}_{dataset}_comparison_curves_with_hist\"
",
