    "import json
",
    "import numpy as np
",
    "from scipy import stats
",
    "import os
",
    "import re
",
    "from collections import defaultdict
",
    "
",
    "# Directory containing the files - UPDATE THIS PATH
",
    "base_dir = \"/home/ptamar/geometric-internal-calibration/calibration_comparison\"
",
    "
",
    "# Group files by dataset+model
",
    "config_files = defaultdict(list)
",
    "
",
    "# Pattern to extract dataset and model from filename
",
    "pattern = r\"ablation_baseline_cross_entropy_(.+?)_(densenet121|resnet\d+)_seed(\d+)\.json\"
",
    "
",
    "for filename in os.listdir(base_dir):
",
    "    if filename.startswith(\"ablation_baseline_cross_entropy_\") and filename.endswith(\".json\"):
",
    "        match = re.match(pattern, filename)
",
    "        if match:
",
    "            dataset = match.group(1)
",
    "            model = match.group(2)
",
    "            seed = match.group(3)
",
    "            config_key = (dataset, model)
",
    "            config_files[config_key].append(os.path.join(base_dir, filename))
",
    "
",
    "# Process each configuration
",
    "print(\"=\" * 80)
",
    "print(\"Deep Ensemble ECE Results\")
",
    "print(\"=\" * 80)
",
    "print()
",
    "
",
    "results = []
",
    "
",
    "for (dataset, model), files in sorted(config_files.items()):
",
    "    all_ece_values = []
",
    "    seeds_used = []
",
    "    
",
    "    for f in files:
",
    "        try:
",
    "            with open(f, 'r') as fp:
",
    "                data = json.load(fp)
",
    "            ece_values = data[\"deep_ensemble_scan\"][\"ece_values\"]
",
    "            master_seed = data[\"deep_ensemble_scan\"][\"master_seed\"]
",
    "            all_ece_values.extend(ece_values)
",
    "            seeds_used.append(master_seed)
",
    "        except Exception as e:
",
    "            print(f\"Error reading {f}: {e}\")
",
    "    
",
    "    if not all_ece_values:
",
    "        continue
",
    "    
",
    "    all_ece_values = np.array(all_ece_values)
",
    "    n = len(all_ece_values)
",
    "    
",
    "    # Compute statistics
",
    "    mean_ece = np.mean(all_ece_values)
",
    "    std_ece = np.std(all_ece_values, ddof=1)
",
    "    sem_ece = stats.sem(all_ece_values)
",
    "    
",
    "    # 95% CI using t-distribution
",
    "    t_critical = stats.t.ppf(0.975, df=n-1)
",
    "    ci_95 = t_critical * sem_ece
",
    "    
",
    "    # Format dataset name for display
",
    "    dataset_display = dataset.replace(\"_\", \" \").title()
",
    "    if dataset_display == \"Tiny Imagenet\":
",
    "        dataset_display = \"Tiny Im.\"
",
    "    
",
    "    results.append({
",
    "        'dataset': dataset,
",
    "        'dataset_display': dataset_display,
",
    "        'model': model,
",
    "        'mean': mean_ece * 100,
",
    "        'ci95': ci_95 * 100,
",
    "        'std': std_ece * 100,
",
    "        'n': n,
",
    "        'seeds': sorted(seeds_used),
",
    "        'n_files': len(files)
",
    "    })
",
    "    
",
    "    print(f\"{dataset_display:12} {model:12} | n={n:3} ({len(files)} files, seeds={sorted(seeds_used)})\")
",
    "    print(f\"{'':26} | ECE: {mean_ece*100:.2f} +/- {ci_95*100:.2f} (95% CI)\")
",
    "    print(f\"{'':26} | ECE: {mean_ece*100:.2f} +/- {std_ece*100:.2f} (std)\")
",
    "    print()
",
    "
",
    "# Print LaTeX-ready table format
",
    "print(\"=\" * 80)
",
    "print(\"LaTeX Table Format (D.Ens column with std):\")
",
    "print(\"=\" * 80)
",
    "for r in results:
",
    "    print(f\"{r['dataset_display']:12} & {r['model']:12} & {r['mean']:.2f}$\\pm${r['std']:.2f}\")"

   ]
